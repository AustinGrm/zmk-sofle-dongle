/*
 * Eyelash Sofle — USB dongle central, no display.
 * Target board: seeeduino_xiao_ble (Seeed Studio XIAO nRF52840).
 *
 * Deliberately does NOT include eyelash_sofle.dtsi: that file enables SPI0
 * (P0.17/P0.20/P0.25), SPI3 WS2812 (P1.12), PWM backlight (P1.13),
 * ext-power (P0.13) and a VDDH battery node — all nice!nano assumptions.
 * On the XIAO those pins collide with the on-board QSPI flash and the
 * board-level battery divider. The dongle only needs the matrix transform,
 * the physical layout and a mock kscan.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "eyelash_sofle-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &eyelash_sofle_layout;
    };

    mock_kscan: kscan_mock {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12)
        >;
    };
};
